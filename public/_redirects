# Force HTTPS
http://*  https://:splat  301!
http://www.*  https://www.:splat  301!

# Handle www subdomain
https://andrewtakacs.com/*  https://www.andrewtakacs.com/:splat  301!

# Security Headers
/*  /:splat
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  X-XSS-Protection: 1; mode=block
  Referrer-Policy: strict-origin-when-cross-origin
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data: https:; connect-src 'self' https:; frame-ancestors 'none'; form-action 'self'; base-uri 'self'
  Permissions-Policy: geolocation=(), microphone=(), camera=()

# Handle static files
/static/*  /static/:splat  200
/manifest.json  /manifest.json  200

# Handle 404s
/*  /404.html  404
/index.html  /  301
/* /index.html 200 